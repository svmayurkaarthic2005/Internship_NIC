DATABASE_URL=postgresql+asyncpg://sis_user:sis_pass@localhost:5432/sis_db
SYNC_DATABASE_URL=postgresql://sis_user:sis_pass@localhost:5432/sis_db
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# Agent (LLM tool-calling) layer. It runs only where the deterministic
# handlers have all passed; set AGENT_ENABLED=false to fall straight back
# to the plain RAG prompt there.
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT_SECONDS=90

# Chat attachments (.txt / .csv / .pdf / .docx). Extracted text, chunks and
# CSV rows live in PostgreSQL, so an attachment survives a restart; the
# original bytes go to UPLOAD_STORAGE_DIR under a server-generated name and
# must NOT be inside a directory the web server serves. Scanned / image-only
# PDFs stay unsupported — there is no OCR.
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_MAX_DOC_PAGES=15
UPLOAD_MAX_DOC_CHARS=20000
UPLOAD_MAX_CSV_ROWS=20000
UPLOAD_MAX_CSV_COLUMNS=200
UPLOAD_EXTRACTION_TIMEOUT_SECONDS=30
UPLOAD_CHUNK_CHARS=1200
UPLOAD_CHUNK_OVERLAP=150
UPLOAD_RETRIEVAL_TOP_K=6
# Share of a question's content words a chunk must carry to count as evidence.
# Below it the officer gets the grounded refusal and the LLM is not called.
UPLOAD_MIN_EVIDENCE_SCORE=0.4
UPLOAD_MAX_DOCS_PER_SESSION=5
UPLOAD_RETENTION_HOURS=72
UPLOAD_EMBEDDINGS_ENABLED=true
UPLOAD_STORE_RAW_FILES=true
# UPLOAD_STORAGE_DIR=/var/lib/sis-chatbot/attachments

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500"]
